# Public surface is a WHITELIST: everything is ignored unless listed below.
# Development material (operating docs, DECISIONS.md, docs/, scripts/, tests/, .agents/)
# lives in ../lowstruct_private/. Those names appear here as untracked symlinks and
# must never be committed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README-ko.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CHANGELOG.md
!/spec/
!/manual/
!/manual-ko/
!/conformance/
!/c/
!/js/
!/python/
!/tools/

# Build output and language caches, even inside whitelisted folders.
*.o
*.a
*.obj
*.lib
*.exe
__pycache__/
*.pyc
*.egg-info/
node_modules/
.DS_Store
